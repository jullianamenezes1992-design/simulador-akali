# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-anon-public-key
# NUNCA exponha no navegador. Usada só no servidor (gravar leads e ler o CPF cifrado).
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key

# Chave de criptografia do CPF (32 bytes em base64). Gere com:  openssl rand -base64 32
# Guarde em local seguro: se perdê-la, os CPFs já gravados não poderão ser lidos.
CPF_ENCRYPTION_KEY=

# URL pública do site (usada em metadados)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br
